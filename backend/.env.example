# Copier ce fichier en ".env" pour le développement local.
# MONGO_URL=mongomock:// -> base en mémoire (rien n'est conservé à l'arrêt)
MONGO_URL=mongomock://
# Boutique de démonstration créée au démarrage (/b/demo-telecom)
DEMO_AU_DEMARRAGE=true
MONGO_DB_NAME=telecom_boutique
MONGO_COLLECTION_PREFIX=tlb_
JWT_SECRET=changez-moi
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
SUPER_ADMIN_EMAIL=admin@exemple.com
SUPER_ADMIN_PASSWORD=motdepasse-a-changer
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_API_TOKEN_SANDBOX=
# Webhook de création des boutiques : secret HMAC partagé (vide = webhook fermé)
WEBHOOK_BOUTIQUES_SECRET=
# SMS (Orange, OVH en repli) : laisser vide en local, les envois sont alors ignorés
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_MSISDN=

# TikTok (connexion du compte de chaque boutique + publication des produits) :
# laisser vide en local, les écrans TikTok affichent alors « non configuré »
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_JETONS_CLE=
